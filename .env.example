# ================================================
# Smart Traffic System — Environment Configuration
# ================================================
# For local development, most values below have safe in-memory defaults
# so no configuration is strictly required.
# Copy this file to .env and customise for production:
#   cp .env.example .env

# ---- Server ----
# HTTP port the Spring Boot application listens on (default: 8080).
PORT=8080

# ---- Database ----
# JDBC URL for the datasource.
# Defaults to an in-memory H2 database (no setup needed for local dev).
# For PostgreSQL: jdbc:postgresql://localhost:5432/trafficdb
SPRING_DATASOURCE_URL=jdbc:h2:mem:trafficdb;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# Database credentials (used when connecting to a real DB).
DB_USER=sa
DB_PASSWORD=

# ---- Traffic Rules ----
# These can also be adjusted directly in application.yml without environment variables.
# Speed threshold (km/h) above which a violation is recorded.
# SPEED_THRESHOLD=80.0
