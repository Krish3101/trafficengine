# ====================================================
# Traffic Violation System — Environment Configuration
# ====================================================
# For local development, all values below have safe in-memory defaults.
# No .env file is strictly required to run locally with H2.
# To customize for local PostgreSQL or production deployment:
#   cp .env.example .env
#
# Note: Real .env files are gitignored and must never be committed.

# ---- Server ----
# HTTP port the application listens on (default: 8080)
PORT=8080

# ---- Database ----
# Datasource JDBC URL
# Default (in-memory H2):
SPRING_DATASOURCE_URL=jdbc:h2:mem:trafficdb;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# Production / Local PostgreSQL example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trafficdb

# Database credentials (used when connecting to an external database like PostgreSQL)
DB_USER=sa
DB_PASSWORD=

# ---- JPA / Hibernate Logging ----
# Toggle SQL query logging in application logs (default: false)
SHOW_SQL=false

# ---- Traffic Rules Configuration ----
# Rule thresholds (speed-threshold, fine-tiers) are defined in application.yml
